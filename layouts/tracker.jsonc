{
  //sets the trackers layout
  //more info: https://github.com/black-sliver/PopTracker/blob/master/doc/PACKS.md#layouts
  "tracker_default": {
    "type": "container",
    "background": "#000000",
    "content": {
      "type": "tabbed",
      "tabs": [
        {
          "title": "Castle",
          "content": [
            {
              "type": "dock",
              "dropshadow": true,
              "content": [
                {
                  "type": "dock",
                  "dock": "bottom",
                  "content": [
                    {
                      "type": "group",
                      "header": "Items",
                      "dock": "left",
                      "margin": "0,0,3,0",
                      "content": {
                        "type": "layout",
                        "h_alignment": "center",
                        "v_alignment": "center",
                        "key": "castle_item_grid"
                      }
                    }
                  ]
                },
                {
                  "type": "map",
                  "maps": [
                    "castle_exterior",
                    "castle_f1",
                    "castle_f2",
                    "castle_basement"
                  ]
                }
              ]
            }
          ]
        },
        {
          "title": "BoB",
          "content": [
            {
              "type": "dock",
              "dropshadow": true,
              "content": [
                {
                  "type": "dock",
                  "dock": "bottom",
                  "content": [
                    {
                      "type": "group",
                      "header": "Items",
                      "dock": "left",
                      "margin": "0,0,3,0",
                      "content": {
                        "type": "layout",
                        "h_alignment": "center",
                        "v_alignment": "center",
                        "key": "bob_item_grid"
                      }
                    }
                  ]
                },
                {
                  "type": "map",
                  "maps": [
                    "bob"
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
