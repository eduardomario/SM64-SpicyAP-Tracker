{
  // sets layouts for shadred items grids
  // bigger example: https://github.com/Cyb3RGER/sm_ap_tracker/blob/main/layouts/items.json
  "shared_item_grid": {
    "type": "tabbed",
    "tabs": [
      {
        "title": "Castle",
        "type": "array",
        "orientation": "horizontal",
        "margin": "0,0",
        "content": [
          {
            "type": "itemgrid",
            "item_margin": "5, 5",
            "h_alignment": "left",
            "rows": [
              [
                "castle_menu_basement_key",
                "castle_menu_second_floor_key"
              ],
              [
                "castle_menu_butterfly",
                "castle_menu_1up",
                "castle_menu_1up_trigger",
                "castle_menu_single_coins",
                "castle_menu_wing_box",
                "castle_menu_cannon",
                "castle_menu_toad",
                "castle_menu_mips",
                "castle_menu_yoshi"
              ],
              [
                "castle_menu_mario_ledge_grab",
                "castle_menu_mario_triple_jump"
              ]
            ]
          }
        ]
      },
      {
        "title": "BoB",
        "type": "array",
        "orientation": "horizontal",
        "margin": "0,0",
        "content": [
          {
            "type": "itemgrid",
            "item_margin": "10, 10",
            "h_alignment": "left",
            "rows": [
              [
                "castle_menu_butterfly"
              ]
            ]
          }
        ]
      }
    ]
  }
}
